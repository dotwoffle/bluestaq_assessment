meta {
  name: post_note
  type: http
  seq: 1
}

post {
  url: http://127.0.0.1:8080/create_note?teamName=team_dotwoffle
  body: json
  auth: inherit
}

params:query {
  teamName: team_dotwoffle
}

body:json {
  {
    "id": "bc6daabe-52d1-420f-8dfa-c56a4e2ba2e5",
    "title": "test_note",
    "content": "this is a note"
  }
}

body:text {
  hi test
}

settings {
  encodeUrl: true
  timeout: 0
}
